{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "agent"],
  "appendPlugins": ["stryker-agent-reporter"],
  "mutate": ["src/**/!(cli).ts"],
  "disableTypeChecks": "src/**/!(cli).ts"
}
